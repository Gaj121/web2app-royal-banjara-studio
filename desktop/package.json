{
  "name": "royalbanjarastudio",
  "productName": "Royal Banjara Studio",
  "version": "1.0.0",
  "description": "Royal Banjara Studio — official desktop app (Windows + Mac)",
  "author": {
    "name": "Royal Banjara Studio",
    "email": "adegajanancsc8@gmail.com"
  },
  "homepage": "https://rbstudiosmusic.kliv.site/",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "site.rbstudiosmusic.desktop",
    "productName": "Royal Banjara Studio",
    "asar": true,
    "files": [
      "main.js",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Utility"
    }
  }
}
